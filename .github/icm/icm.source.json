      ],
      "human_check": "A maintainer approves the version number and the changelog wording. The number is permanent once tagged: a mistake later costs a new version, never a retag.",
      "required": [
        "03-release-stages-01_plan-CONTEXT.md"
      ]
    },
    "release-prepare": {
      "order": 2,
      "contract": ".github/icm/03-release/stages/02_prepare/CONTEXT.md",
      "inputs": {
        "working": [
          ".github/icm/03-release/stages/01_plan/output/release-plan.md"
        ],
        "reference": [
          ".github/icm/_shared/release.md",
          ".github/icm/_shared/build-and-test.md",
          "PUBLISH_CHECKLIST.md"
        ]
      },
      "do_not_load": [
        ".github/icm/01-fix/",
        ".github/icm/02-schema/",
        ".github/icm/04-deps/"
      ],
      "outputs": [
        ".github/icm/03-release/stages/02_prepare/output/release-pr.md"
      ],
      "human_check": "A maintainer reviews the final commit with every check green and the title exactly `release: mqtt-schema vX.Y.Z`. Merging it is the publish decision; the maintainer makes it, squash-merging so that the title is the commit's first line.",
      "required": [
        "03-release-stages-02_prepare-CONTEXT.md"
      ]
    },
    "release-publish": {
      "order": 3,
      "contract": ".github/icm/03-release/stages/03_publish/CONTEXT.md",
      "inputs": {
        "working": [
          ".github/icm/03-release/stages/02_prepare/output/release-pr.md"
        ],
        "reference": [
          ".github/icm/_shared/release.md"
        ]
      },
      "do_not_load": [
        ".github/icm/01-fix/",
        ".github/icm/02-schema/",
        ".github/icm/04-deps/"
      ],
      "outputs": [
        ".github/icm/03-release/stages/03_publish/output/publication.md"
      ],
      "human_check": "A person confirms the version is on npm, on GitHub Packages and in the GitHub releases before it is announced, and has run every dispatch the agent listed.",
      "required": [
        "03-release-stages-03_publish-CONTEXT.md"
      ]
    },
    "deps-review": {
      "order": 1,
      "contract": ".github/icm/04-deps/stages/01_review/CONTEXT.md",
      "inputs": {
        "working": [],
        "reference": [
          ".github/icm/_shared/gotchas.md",
          ".github/icm/_shared/build-and-test.md"
        ]
      },
      "do_not_load": [
        ".github/icm/01-fix/",
        ".github/icm/02-schema/",
        ".github/icm/03-release/"
      ],
      "outputs": [
        ".github/icm/04-deps/stages/01_review/output/review.md"
      ],
      "human_check": "A person reads `review.md` and decides: merge, wait, or close. A runtime bump that changes any validator's result is never merged from here.",
      "required": [
        "04-deps-stages-01_review-CONTEXT.md"
      ],
      "optional": [
        "shared-release.md"
      ]
    }
  }
}
